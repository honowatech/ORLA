APP_NAME=ORLA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Douala
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Jeton protégeant la route de maintenance (migrations sans SSH). Laisser vide pour la désactiver.
APP_DEPLOY_TOKEN=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de données -------------------------------------------------------
# Production (hébergement mutualisé) : MySQL / MariaDB (InnoDB obligatoire).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=orla
DB_USERNAME=root
DB_PASSWORD=

# Développement local rapide : décommenter pour utiliser sqlite.
# DB_CONNECTION=sqlite
# DB_DATABASE=/chemin/absolu/vers/database/database.sqlite

# --- Session, cache, files ---------------------------------------------------
# Sur hébergement mutualisé sans table "sessions", conserver le pilote "file".
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Courriel --------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="contact@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- SaaS (multi-entreprises) ----------------------------------------------
# Durée de l'essai gratuit offert à toute nouvelle entreprise (0 = paiement immédiat).
SAAS_ESSAI_JOURS=14
# Lève une exception si un modèle cloisonné est interrogé sans entreprise courante.
SAAS_TENANCY_STRICT=true
# Entreprise créée automatiquement pour rattacher les données existantes lors de la migration.
SAAS_ENTREPRISE_LEGACY_NOM=Speedex
SAAS_ENTREPRISE_LEGACY_SLUG=speedex
# Tarif de livraison par défaut (FCFA) appliqué aux nouvelles paires de zones.
SAAS_TARIF_DEFAUT=1000
SAAS_DEVISE=XAF
SAAS_PAYS=CM
SAAS_PREFIXE_TELEPHONE=+237

# --- Site vitrine ----------------------------------------------------------
SITE_NOM="${APP_NAME}"
SITE_BASELINE="Logiciel de gestion de livraison pour entreprises de coursiers"
SITE_CONTACT_EMAIL=contact@example.com
SITE_CONTACT_TEL=
SITE_ANALYTICS_SCRIPT=

VITE_APP_NAME="${APP_NAME}"
