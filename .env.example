APP_NAME=Speedex
APP_ENV=local
# Générer avec : php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_LEVEL=debug

# En local, SQLite suffit : touch database/database.sqlite
# En production (cPanel) : DB_CONNECTION=mysql, DB_HOST=localhost,
# base et utilisateur préfixés par le compte cPanel.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=speedex
# DB_USERNAME=root
# DB_PASSWORD=

# Aucune migration ne crée les tables sessions/cache : garder « file ».
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Mot de passe des comptes créés par « php artisan migrate:fresh --seed »
# (généré et affiché s'il est vide).
SEED_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
